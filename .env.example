# development => SQLite local (database.sqlite), schema sincronizado automaticamente
# qualquer outro valor => Postgres + migrations (DATABASE_URL ou DB_*)
NODE_ENV=production
PORT=3000

# Obrigatorio fora de development. Gere com: openssl rand -base64 48
JWT_SECRET=

# Postgres: use a URL (Neon, Supabase...) ou as variaveis individuais
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=finance
# DB_PASS=finance
# DB_NAME=finance
# DB_SSL=true

# Origens permitidas no CORS (separadas por virgula). Vazio ou * = qualquer origem
CORS_ORIGINS=*

# SMTP para o e-mail de redefinicao de senha (obrigatorio fora de development)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Xpen6 <no-reply@xpen6.app>"

# Opcional: URL de uma pagina web de redefinicao; o e-mail sempre inclui o codigo
PASSWORD_RESET_URL=
